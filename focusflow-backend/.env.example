# Copy to .env for local development. Never commit the real .env file.

DATABASE_URL=postgresql://focusflow:password@localhost:5432/focusflow

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
